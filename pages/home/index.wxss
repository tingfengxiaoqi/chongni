.page { padding: 24rpx 28rpx 40rpx; }
.top { display: flex; justify-content: space-between; gap: 16rpx; }
.loc { margin-top: 8rpx; color: #8A8178; font-size: 24rpx; }
.switch { display: flex; align-items: center; gap: 12rpx; }
.chip {
  display: flex; align-items: center; gap: 10rpx;
  background: #1F1A17; color: #fff; border-radius: 999rpx;
  padding: 8rpx 16rpx 8rpx 8rpx; font-size: 24rpx;
}
.dot {
  width: 44rpx; height: 44rpx; border-radius: 50%; background: #FFF1E6;
  display: flex; align-items: center; justify-content: center; overflow: hidden; color: #1F1A17;
}
.dot image { width: 100%; height: 100%; }
.add {
  width: 60rpx; height: 60rpx; border-radius: 50%; background: #fff;
  text-align: center; line-height: 56rpx; font-size: 36rpx;
  box-shadow: 0 8rpx 20rpx rgba(80,40,10,.06);
}
.hero {
  margin-top: 24rpx; padding: 28rpx; border-radius: 32rpx;
  background: linear-gradient(135deg, #FF8A4C, #FF5B1F 60%, #E84A12); color: #fff;
}
.hero-main { display: flex; gap: 20rpx; align-items: center; }
.hero-avatar {
  width: 112rpx; height: 112rpx; border-radius: 24rpx; background: rgba(255,255,255,.2);
  display: flex; align-items: center; justify-content: center; font-size: 56rpx; overflow: hidden; flex: none;
}
.hero-avatar image { width: 100%; height: 100%; }
.hero-name { font-size: 44rpx; font-weight: 720; }
.hero-meta { margin-top: 6rpx; opacity: .92; font-size: 24rpx; }
.stats { display: flex; gap: 12rpx; margin-top: 24rpx; }
.stat {
  flex: 1; background: rgba(255,255,255,.16); border-radius: 20rpx;
  padding: 16rpx 8rpx; text-align: center;
}
.num { display: block; font-size: 34rpx; font-weight: 700; }
.lab { font-size: 20rpx; opacity: .92; }
.quick { display: flex; gap: 14rpx; margin: 24rpx 0; }
.q {
  flex: 1; background: #fff; border-radius: 24rpx; padding: 22rpx 8rpx;
  text-align: center; box-shadow: 0 10rpx 24rpx rgba(80,40,10,.05); font-size: 24rpx;
}
.ico { font-size: 36rpx; margin-bottom: 8rpx; }
.sec-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.sec-title { font-size: 30rpx; font-weight: 700; }
.edit { color: #E24B4B; font-size: 24rpx; }
.kv { display: flex; gap: 20rpx; margin-top: 12rpx; font-size: 26rpx; }
.k { width: 80rpx; color: #8A8178; flex: none; }
.item { padding: 16rpx 0; border-bottom: 1rpx solid #EFE7DC; }
.item:last-child { border-bottom: 0; }
.item.row { display: flex; justify-content: space-between; gap: 12rpx; }
.item-title { font-weight: 650; }
.tip-card { margin-top: 28rpx; }
.types { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.type {
  flex: 1; min-height: 110rpx; border-radius: 20rpx; background: #F7F1EA;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 6rpx; font-size: 24rpx;
}
.type.on { background: #FF6A2A; color: #fff; }
