.page { padding: 24rpx 28rpx 40rpx; }
.head { display: flex; gap: 20rpx; align-items: center; }
.avatar {
  width: 112rpx; height: 112rpx; border-radius: 28rpx;
  background: linear-gradient(135deg, #FFB07A, #FF6A2A);
  color: #fff; display: flex; align-items: center; justify-content: center; font-size: 48rpx; flex: none;
}
.meta { flex: 1; min-width: 0; }
.name { font-size: 40rpx; font-weight: 720; }
.edit { font-size: 28rpx; }
.gear { font-size: 36rpx; padding: 8rpx; }
.stats {
  display: flex; text-align: center; margin: 28rpx 0;
}
.stats > view { flex: 1; }
.n { font-size: 36rpx; font-weight: 700; }
.menu { padding: 8rpx 16rpx; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 8rpx; border-bottom: 1rpx solid #EFE7DC;
}
.row:last-child { border-bottom: 0; }
.right { color: #8A8178; display: flex; align-items: center; gap: 8rpx; }
.badge {
  min-width: 32rpx; height: 32rpx; padding: 0 8rpx; border-radius: 999rpx;
  background: #E24B4B; color: #fff; font-size: 20rpx; line-height: 32rpx; text-align: center;
}
