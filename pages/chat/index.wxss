.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F6F1EA;
}

.list {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx 12rpx;
  box-sizing: border-box;
}

.tip {
  text-align: center;
  color: #A39A91;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.row.me {
  justify-content: flex-end;
}

.av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFF1E6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex: none;
}

.me-av {
  background: #1F1A17;
  color: #fff;
}

.bubble {
  max-width: 70%;
  background: #fff;
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(80, 40, 10, 0.05);
  line-height: 1.55;
  font-size: 28rpx;
}

.row.me .bubble {
  background: #FF6A2A;
  color: #fff;
}

.time {
  margin-top: 8rpx;
  font-size: 20rpx;
  opacity: 0.55;
}

.composer {
  display: flex;
  gap: 12rpx;
  align-items: center;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFDF9;
  border-top: 1rpx solid #EFE7DC;
}

.composer .input {
  flex: 1;
  min-height: 72rpx;
  background: #F6F1EA;
  border-radius: 999rpx;
  padding: 0 24rpx;
  border: 0;
}

.send {
  min-width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #FF6A2A;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.send.disabled {
  background: #E8DFD4;
  color: #A39A91;
}
