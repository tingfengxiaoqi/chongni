.page { padding: 24rpx 28rpx 160rpx; }
.head-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; }
.login-pill {
  flex: none; background: #FF6A2A; color: #fff; border-radius: 999rpx;
  padding: 12rpx 22rpx; font-size: 24rpx; font-weight: 650;
}
.post { margin-top: 16rpx; }
.head { display: flex; gap: 16rpx; align-items: flex-start; }
.who { flex: 1; min-width: 0; }
.av {
  width: 72rpx; height: 72rpx; border-radius: 50%; background: #FFF1E6;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex: none;
}
.av.sm { width: 56rpx; height: 56rpx; font-size: 28rpx; }
.name-row { display: flex; align-items: center; gap: 10rpx; }
.name { font-weight: 650; }
.mine-tag {
  font-size: 20rpx; color: #FF6A2A; background: #FFF1E6; border-radius: 8rpx; padding: 2rpx 8rpx;
}
.more { color: #8A8178; font-size: 24rpx; flex: none; padding: 4rpx 0 4rpx 12rpx; }
.add-friend {
  flex: none; font-size: 22rpx; color: #FF6A2A; background: #FFF1E6;
  border-radius: 999rpx; padding: 8rpx 16rpx; font-weight: 650;
}
.friend-tag { flex: none; font-size: 22rpx; color: #8A8178; padding: 8rpx 0; }
.switch-row {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 8rpx 0 4rpx;
}
.switch {
  width: 84rpx; height: 48rpx; border-radius: 999rpx; background: #E8DDD0;
  position: relative; flex: none; transition: background .2s;
}
.switch.on { background: #FF6A2A; }
.switch .knob {
  width: 40rpx; height: 40rpx; border-radius: 50%; background: #fff;
  position: absolute; top: 4rpx; left: 4rpx; transition: left .2s;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.12);
}
.switch.on .knob { left: 40rpx; }
.body { margin: 16rpx 0; line-height: 1.7; font-size: 28rpx; white-space: pre-wrap; }
.photo {
  width: 100%; height: 360rpx; border-radius: 18rpx; background: #F7EEE4; display: block;
}
.imgs { display: flex; gap: 12rpx; }
.ph {
  flex: 1; aspect-ratio: 1; border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center; font-size: 48rpx;
}
.preview {
  margin-top: 14rpx; background: #F8F3EC; border-radius: 16rpx; padding: 14rpx 16rpx;
}
.preview-line { font-size: 24rpx; color: #5C5144; line-height: 1.5; margin-bottom: 6rpx; }
.preview-line:last-child { margin-bottom: 0; }
.preview-user { font-weight: 650; color: #2C241C; margin-right: 6rpx; }
.acts { display: flex; gap: 8rpx; margin-top: 18rpx; color: #8A8178; font-size: 24rpx; }
.act { padding: 8rpx 16rpx; border-radius: 999rpx; background: #F8F3EC; }
.act.on { color: #E24B4B; background: #FFE8E0; }
.fab {
  position: fixed; left: 50%; bottom: calc(140rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%); width: 96rpx; height: 96rpx; border-radius: 50%;
  background: #FF6A2A; color: #fff; font-size: 56rpx; line-height: 88rpx; text-align: center;
  box-shadow: 0 16rpx 36rpx rgba(255,106,42,.35); z-index: 20;
}
.empty { text-align: center; color: #8A8178; padding: 80rpx 0 40rpx; }
.empty-emoji { font-size: 64rpx; margin-bottom: 8rpx; }
.loading { text-align: center; padding: 24rpx; }
.count { text-align: right; margin-top: 8rpx; }
.emoji-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.emoji {
  width: 72rpx; height: 72rpx; border-radius: 18rpx; background: #F8F3EC;
  display: flex; align-items: center; justify-content: center; font-size: 36rpx;
}
.emoji.on { background: #FFE8D6; box-shadow: inset 0 0 0 2rpx #FF6A2A; }
.photo-box {
  height: 160rpx; border-radius: 18rpx; background: #F8F3EC; color: #8A8178;
  display: flex; align-items: center; justify-content: center;
}
.photo-wrap { position: relative; }
.photo-preview { width: 100%; height: 280rpx; border-radius: 18rpx; display: block; }
.photo-clear {
  position: absolute; right: 16rpx; top: 16rpx; background: rgba(0,0,0,.55); color: #fff;
  font-size: 22rpx; padding: 8rpx 16rpx; border-radius: 999rpx;
}
.sheet.tall { max-height: 78vh; display: flex; flex-direction: column; }
.comment-list { flex: 1; max-height: 52vh; }
.comment { display: flex; gap: 14rpx; padding: 16rpx 0; border-bottom: 1rpx solid #F3EBE1; }
.comment-body { flex: 1; min-width: 0; }
.comment-text { margin: 6rpx 0; line-height: 1.5; }
.comment-bar {
  display: flex; gap: 12rpx; align-items: center; padding-top: 16rpx;
  border-top: 1rpx solid #F0E7DC; margin-top: 8rpx;
}
.comment-input {
  flex: 1; background: #F8F3EC; border-radius: 999rpx; padding: 16rpx 24rpx; font-size: 26rpx;
}
.guest-tip { text-align: center; color: #FF6A2A; padding: 20rpx 0 8rpx; }
.btn.disabled { opacity: .55; }
.pressed { opacity: .86; }
