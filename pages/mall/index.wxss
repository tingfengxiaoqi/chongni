.page { padding: 24rpx 28rpx 160rpx; }
.head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }
.loc { color: #8A8178; font-size: 22rpx; }
.goods { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.good {
  width: calc(50% - 8rpx); background: #fff; border-radius: 24rpx; overflow: hidden;
  box-shadow: 0 10rpx 24rpx rgba(80,40,10,.05); box-sizing: border-box;
}
.pic, .pic-img {
  height: 220rpx; background: #F7EEE4; display: flex; align-items: center; justify-content: center; font-size: 64rpx;
}
.pic-img { width: 100%; display: block; }
.body { padding: 16rpx; }
.title { font-size: 24rpx; line-height: 1.4; min-height: 68rpx; }
.sold { color: #8A8178; font-size: 20rpx; margin: 6rpx 0; }
.bottom { display: flex; justify-content: space-between; align-items: center; }
.price { color: #E24B4B; font-weight: 700; }
.detail-hint { margin-top: 10rpx; font-size: 20rpx; color: #B5AAA0; }
.plus {
  width: 48rpx; height: 48rpx; border-radius: 50%; background: #FF6A2A; color: #fff;
  text-align: center; line-height: 44rpx; font-size: 32rpx;
}
.cart-bar {
  position: fixed; left: 28rpx; right: 28rpx; bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex; justify-content: space-between; align-items: center;
  background: #2C241C; color: #FFF8F1; border-radius: 999rpx;
  padding: 22rpx 28rpx; font-weight: 650;
  box-shadow: 0 12rpx 28rpx rgba(44,36,28,.22); z-index: 10;
}
.cart-bar .go { color: #FFB48A; }
.empty { text-align: center; color: #8A8178; padding: 60rpx 0; }
.pressed { opacity: .88; }
