.page { padding: 24rpx 28rpx 40rpx; }
.cal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.nav { width: 56rpx; height: 56rpx; text-align: center; line-height: 52rpx; font-size: 36rpx; }
.grid { display: flex; flex-wrap: wrap; }
.wd, .day { width: 14.28%; text-align: center; box-sizing: border-box; }
.wd { color: #8A8178; font-size: 22rpx; padding: 10rpx 0; }
.day {
  min-height: 78rpx; border-radius: 16rpx; padding: 8rpx 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx;
}
.day.empty { pointer-events: none; }
.day.on { background: #1F1A17; color: #fff; }
.dots { display: flex; gap: 4rpx; min-height: 10rpx; }
.dot { width: 8rpx; height: 8rpx; border-radius: 50%; }
.legend { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 18rpx; color: #8A8178; font-size: 22rpx; }
.lg { display: inline-block; width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 6rpx; vertical-align: middle; }
.day-head { display: flex; justify-content: space-between; align-items: center; margin: 20rpx 0 12rpx; }
.sec { font-size: 30rpx; font-weight: 700; }
.item { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.left { display: flex; align-items: center; gap: 16rpx; min-width: 0; }
.mark { width: 16rpx; height: 16rpx; border-radius: 50%; flex: none; }
.title { font-weight: 650; }
.sums { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.sum { flex: 1; margin-bottom: 0; }
.big { font-size: 40rpx; font-weight: 720; margin-top: 8rpx; }
.exp { display: flex; justify-content: space-between; gap: 12rpx; padding: 18rpx 0; border-bottom: 1rpx solid #EFE7DC; }
.exp:last-child { border-bottom: 0; }
