<view class="page" wx:if="{{goods}}">
  <swiper class="banner" indicator-dots circular wx:if="{{banners.length}}">
    <swiper-item wx:for="{{banners}}" wx:key="*this">
      <image class="banner-img" src="{{item}}" mode="aspectFill" bindtap="onPreview" data-src="{{item}}" />
    </swiper-item>
  </swiper>
  <view class="banner emoji" wx:else>
    <text class="big">{{goods.icon || '🛒'}}</text>
  </view>

  <view class="card main">
    <view class="price-row">
      <view class="price"><text class="yen">¥</text>{{goods.price}}</view>
      <view class="sold-tag">已售 {{goods.sold}}</view>
    </view>
    <view class="name">{{goods.name}}</view>
    <view class="desc" wx:if="{{goods.desc}}">{{goods.desc}}</view>
  </view>

  <view class="card">
    <view class="sec">商品信息</view>
    <view class="kv">
      <text class="k">分类</text>
      <text class="v">{{goods.cat}}</text>
    </view>
    <view class="kv">
      <text class="k">库存</text>
      <text class="v">{{goods.stock > 0 ? (goods.stock + ' 件') : '暂时缺货'}}</text>
    </view>
    <view class="kv">
      <text class="k">销量</text>
      <text class="v">{{goods.sold}}</text>
    </view>
  </view>

  <view class="card">
    <view class="sec">产品介绍</view>
    <view class="intro" wx:if="{{goods.intro}}">{{goods.intro}}</view>
    <view class="muted" wx:else>商家暂未填写详细介绍，可先看看图集与基础信息。</view>
    <view class="detail-imgs" wx:if="{{detailImgs.length}}">
      <image
        class="detail-img"
        wx:for="{{detailImgs}}"
        wx:key="*this"
        src="{{item}}"
        mode="widthFix"
        bindtap="onPreview"
        data-src="{{item}}"
      />
    </view>
  </view>

  <view class="bar">
    <view class="bar-left" bindtap="goCart" hover-class="pressed">
      <text class="cart-ico">🛒</text>
      <text class="muted tiny">购物车{{cartCount ? ' ' + cartCount : ''}}</text>
    </view>
    <view class="btn ghost sm" bindtap="onAdd" hover-class="pressed">加入购物车</view>
    <view class="btn sm" bindtap="onBuy" hover-class="pressed">立即购买</view>
  </view>
</view>

<view class="empty" wx:elif="{{!loading}}">商品不存在或已下架</view>
<view class="empty muted" wx:else>加载中…</view>
