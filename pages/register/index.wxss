.page {
  padding: 28rpx 32rpx 64rpx;
}

.kicker {
  color: #FF6A2A;
  font-size: 24rpx;
}

.species {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
}

.sp {
  flex: 1;
  text-align: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 8rpx;
  border: 4rpx solid transparent;
  box-shadow: 0 10rpx 24rpx rgba(80, 40, 10, 0.05);
}

.sp.on {
  border-color: #FF6A2A;
  background: #FFF1E6;
}

.emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.avatar-box {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 16rpx;
}

.preview {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: #FFF1E6;
  border: 2rpx dashed #F0C4A6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  overflow: hidden;
  flex: none;
}

.preview image {
  width: 100%;
  height: 100%;
}

.tip {
  margin-top: 12rpx;
}

.emoji-row {
  white-space: nowrap;
}

.emoji-item {
  display: inline-flex;
  width: 80rpx;
  height: 80rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid transparent;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.emoji-item.on {
  border-color: #FF6A2A;
  background: #FFF1E6;
}
