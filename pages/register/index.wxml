<view class="page">
  <view class="kicker">{{mode === 'add' ? '再请一只毛孩子' : '注册第 2 步 · 登记宠物'}}</view>
  <view class="h1">{{mode === 'add' ? '家里还有谁？' : '家里那位，介绍一下？'}}</view>
  <view class="sub">这些信息之后随时能改{{city ? ' · 当前城市 ' + city : ''}}</view>

  <view class="species">
    <view class="sp {{species === 'cat' ? 'on' : ''}}" data-id="cat" bindtap="onSpecies" hover-class="pressed">
      <view class="emoji">🐱</view>
      <view>猫</view>
    </view>
    <view class="sp {{species === 'dog' ? 'on' : ''}}" data-id="dog" bindtap="onSpecies" hover-class="pressed">
      <view class="emoji">🐶</view>
      <view>狗</view>
    </view>
    <view class="sp {{species === 'reptile' ? 'on' : ''}}" data-id="reptile" bindtap="onSpecies" hover-class="pressed">
      <view class="emoji">🦎</view>
      <view>爬虫</view>
    </view>
  </view>

  <view class="field">
    <text class="field-label">名字</text>
    <input class="input" placeholder="比如：小煤球" value="{{name}}" bindinput="onName" maxlength="12" />
  </view>
  <view class="row-2">
    <view class="field">
      <text class="field-label">品种</text>
      <input class="input" placeholder="自己填写，如英短" value="{{breed}}" bindinput="onBreed" maxlength="20" />
    </view>
    <view class="field">
      <text class="field-label">性别</text>
      <picker class="picker" range="{{genders}}" value="{{genderIndex}}" bindchange="onGender">
        <view>{{genders[genderIndex]}}</view>
      </picker>
    </view>
  </view>
  <view class="row-2">
    <view class="field">
      <text class="field-label">生日</text>
      <picker class="picker" mode="date" value="{{birthday}}" bindchange="onBirthday">
        <view>{{birthday || '年 / 月 / 日'}}</view>
      </picker>
    </view>
    <view class="field">
      <text class="field-label">体重 kg</text>
      <input class="input" type="digit" placeholder="例如 4.8" value="{{weight}}" bindinput="onWeight" />
    </view>
  </view>

  <view class="field">
    <text class="field-label">头像</text>
    <view class="avatar-box">
      <view class="preview" bindtap="onPickPhoto">
        <image wx:if="{{photo}}" src="{{photo}}" mode="aspectFill"></image>
        <text wx:else>{{avatar}}</text>
      </view>
      <view class="avatar-tip">
        <view class="btn ghost sm" bindtap="onPickPhoto" hover-class="pressed">点击上传真实照片</view>
        <view class="muted tiny tip">或者直接在下面挑个 emoji</view>
      </view>
    </view>
    <scroll-view class="emoji-row" scroll-x>
      <view
        class="emoji-item {{!photo && avatar === item ? 'on' : ''}}"
        wx:for="{{emojis}}"
        wx:key="*this"
        data-emoji="{{item}}"
        bindtap="onEmoji"
      >{{item}}</view>
    </scroll-view>
  </view>

  <view class="btn" bindtap="onSave" hover-class="pressed">{{mode === 'add' ? '保存' : '完成，进入宠溺'}}</view>
</view>
