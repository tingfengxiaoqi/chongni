<view class="page">
  <image class="logo" src="/images/logo.png" mode="aspectFill"></image>
  <view class="name">宠溺</view>
  <view class="slogan">和毛孩子一起，被这座城市温柔以待</view>
  <view class="tags">
    <text class="tag-item">🩺 健康档案</text>
    <text class="tag-item">🗓️ 驱虫提醒</text>
    <text class="tag-item">🔥 花销账本</text>
  </view>

  <view class="card form">
    <view class="field">
      <text class="field-label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入 11 位手机号" value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <text class="field-label">验证码</text>
      <view class="code-row">
        <input class="input code-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="onCode" />
        <view class="btn ghost sm code-btn" bindtap="onSend" hover-class="pressed">{{smsText}}</view>
      </view>
    </view>
    <view class="btn {{loading ? 'disabled' : ''}}" bindtap="onLogin" hover-class="pressed">登录 / 注册</view>
    <view class="guest" bindtap="onGuest" hover-class="pressed">先随便逛逛</view>
    <view class="foot">账号数据保存在服务端。游客可浏览广场与附近，下单、聊天、建档需登录。</view>
  </view>
</view>
